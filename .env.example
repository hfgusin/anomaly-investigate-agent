# responses uses /responses with native web_search; chat-completions uses /chat/completions.
# Demo makes no model API requests. Choose chat-completions to connect a provider.
MIRROR_RUNTIME=demo
# Python LangChain runtime (native preserves the former TS provider for comparison).
AGENT_ENGINE=langchain
AGENT_PYTHON=.venv-di/bin/python
# Set your existing provider's API root, including its /v1 or equivalent path.
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
# standard uses assistant tool_calls + tool messages; plain is for endpoints that cannot process tool messages.
MODEL_TOOL_RESULT_MODE=standard
RUN_TIMEOUT_MS=120000
# Shared token buckets: refill per minute, allow an initial burst; no automatic retry.
MODEL_REQUESTS_PER_MINUTE=60
MODEL_REQUEST_BURST=12
MODEL_MAX_CONCURRENT=4
GATEWAY_REQUESTS_PER_MINUTE=600
GATEWAY_BURST=100
CONNECTION_REQUESTS_PER_MINUTE=120
CONNECTION_BURST=40
SESSION_SENDS_PER_MINUTE=20
SESSION_SEND_BURST=8
# Prompt budget measured in characters. The runtime retains newest complete turns first.
CONTEXT_BUDGET_CHARS=120000
PORT=18789
# Code execution is disabled until OS/network isolation is available.
# Explicit opt-in is for trusted local experiments only; Node permissions are not a full sandbox.
MIRROR_ENABLE_CODE=false
# Optional absolute directory for the SQLite database; default is .data/.
# MIRROR_DATA_DIR=

# Responses-only native search settings
RESPONSES_WEB_SEARCH=true
RESPONSES_MAX_KEYWORD=3
# Optional: enabled or disabled; omit to use the selected model default.
# MODEL_THINKING=disabled

# RAG 意图路由：本地 MiniLM 召回样例，再由小模型判定 Skill / general / clarify / out-of-scope
# 安装 python/requirements.lock.txt；需 Sentence Transformers MiniLM 本地缓存（下载命令见下方文档）
# 操作和评测见 docs/intent-routing.md
# MIRROR_ROUTER=true
# ROUTER_MODEL_NAME=doubao-seed-2-0-mini-260428
# 评测评分模型（python/evaluation/judge.py）
# JUDGE_MODEL_NAME=deepseek-v4-pro-ga-260813
# 离线演示：外部服务全部换成该 world 文件里的虚构数据
# MIRROR_DEMO_WORLD=/absolute/path/portfolio/evaluation/worlds/W01.json

# Optional Airflow v1 API (python/agent_backend/tools/airflow.py). Restart pnpm dev after editing.
# AIRFLOW_BASE_URL=http://35.247.161.180:8080
# Basic auth; if the API rejects it, automatically log in using CSRF + session Cookie:
# AIRFLOW_USERNAME=
# AIRFLOW_PASSWORD=
# Or Bearer auth (used when set):
# AIRFLOW_TOKEN=
# Optional raw Cookie header, for deployments whose API only accepts a browser session:
# AIRFLOW_COOKIE=session=...
# Automation dashboard (scs_take_rate_ads) Airflow; defaults to http://34.142.225.103:8080
# AUTOMATION_AIRFLOW_BASE_URL=
# AUTOMATION_AIRFLOW_COOKIE=session=...
# 独立翻译模型（预留，当前代码尚未读取；留空不影响现有模型）
# 接口类型：responses 或 chat-completions
RAG_TRANSLATION_RUNTIME=
# API 根地址，例如 https://example.com/api/v3（与接口类型对应）
RAG_TRANSLATION_BASE_URL=
RAG_TRANSLATION_MODEL_NAME=
RAG_TRANSLATION_API_KEY=
# 广告自动化看板（本机只读；session 留空时读取检查快照中的已知 session）
AUTOMATION_DI_SESSION_ID=
AUTOMATION_DI_IDENTITY=yara.huang
AUTOMATION_DI_BIN=
# 可选：已有 Google OAuth access token，只保存在本地。留空则明确使用规则快照。
AUTOMATION_GSHEET_ACCESS_TOKEN=
# 事后记录写入 GSheet 的 OAuth token，需具备 spreadsheets 写权限。
# 目标表和 tab 在 config/check-records.json；Codex 连接授权不等于本地应用授权。
CHECK_GSHEET_ACCESS_TOKEN=
# 推荐：服务账号自动获取 / 刷新 token。标准 JSON 或命名字典都支持。
CHECK_GSHEET_SERVICE_ACCOUNT_FILE=
CHECK_GSHEET_SERVICE_ACCOUNT_NAME=client_secret
# Python DI 查询与 CSV 导出（优先复用已有 sg session；留空则在工具审批后创建）
DI_SESSION_ID=
# 直接 +sql 的 SQL session（与上述 PySpark 导出 session 分开；留空由 CLI 创建）
DI_SQL_SESSION_ID=
DI_IDENTITY=yara.huang
DI_QUEUE=cnfashionbi-dev
DI_SESSION_NAME=openclaw-mirror
DI_PYTHON=.venv-di/bin/python
DI_BIN=
